    {
      "id": "OID4VCI-KEY-ATTESTATION-001",
      "section": "Appendix D.1 Key Attestation in JWT format; Appendix F.1, F.3, and F.4 Proof Types",
      "keyword": "MUST",
      "roles": [
        "credential_issuer"
      ],
      "feature": "jwt_proof_key_attestation",
      "requirement": "Key attestation is evaluated only as key-scoped assurance using mandatory trusted time and selected-metadata algorithm policy. The complete unique public key set, temporal claims, security properties, certification, status, and trust provenance are retained; JWT proof keys must be present in that set and direct attestation produces one batch-bounded credential binding per key. Wallet attestation does not satisfy this requirement.",
      "implementation": [
        "openid4vci_attestation::verify_key_attestation",
        "openid4vci_issuer::KeyAttestationPolicy::from_proof_metadata",
        "openid4vci_issuer::JoseJwtProofVerifier::with_key_attestation_verifier",
        "openid4vci_issuer::KeyAttestationProofVerifier"
      ],
      "tests": [
        "jose_verifier_accepts_header_key_attestation",
        "jose_verifier_rejects_expired_header_key_attestation",
        "jose_verifier_rejects_header_key_attestation_for_different_key",
        "jose_verifier_rejects_header_key_attestation_without_verifier",
        "key_attestation_rejects_private_or_symmetric_attested_keys",
        "key_attestation_enforces_inclusive_time_boundaries",
        "key_attestation_preserves_unknown_resistance_and_trust_provenance",
        "direct_attestation_exposes_every_attested_key_for_credential_binding",
        "direct_attestation_enforces_security_property_policy",
        "endpoint_enforces_batch_ceiling_after_verified_key_expansion",
        "endpoint_rejects_missing_key_attestation_when_required",
        "mixed_proof_policy_is_selected_by_submitted_type_independent_of_map_order"
      ],
      "oidf_modules": [
        "oid4vci-1_0-issuer-fail-invalid-key-attestation-signature"
      ],
      "conformance_evidence": [
        "vectors/openid4vci-trust-evidence.json",
        "crates/attestation/tests/key_attestation_tests.rs",
        "crates/issuer/tests/attestation_proof_tests.rs"
      ],
      "applicable": true,
      "status": "implemented"
    },
